# Mot de passe de l'espace admin (à changer en production)
ADMIN_PASSWORD=change-me-please

# Secret de signature du cookie admin (chaîne aléatoire longue)
ADMIN_SECRET=change-me-with-a-long-random-string

# Secret attendu sur /api/cron/cleanup (Bearer token)
CRON_SECRET=change-me-cron-secret

# Origine publique utilisée pour les QR codes connectés (optionnel en dev)
# NEXT_PUBLIC_SITE_URL=https://oopsqr.fr

# Emplacement des données (optionnel, défaut : ./data)
# DATA_DIR=./data

# AdSense (optionnel). Les emplacements restent des placeholders sans ces variables.
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx
# NEXT_PUBLIC_ADSENSE_SLOT_HOME=xxxxxxxxxx
