# Mot de passe de l'espace admin (à changer en production)
ADMIN_PASSWORD=change-me-please

# Secret de signature du cookie admin (chaîne aléatoire longue)
ADMIN_SECRET=change-me-with-a-long-random-string

# Secret attendu sur /api/cron/cleanup (Bearer token)
CRON_SECRET=change-me-cron-secret

# Base Postgres serverless (Neon / Vercel Postgres) — OBLIGATOIRE
# Format : postgres://user:password@host/db?sslmode=require
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Origine publique utilisée pour les QR codes connectés (optionnel en dev)
# NEXT_PUBLIC_SITE_URL=https://oopsqr.fr

# Version Node de référence (Render / Vercel) — Next.js 16 exige Node >= 20.9
NODE_VERSION=22.x

# AdSense (optionnel). Les emplacements restent des placeholders sans ces variables.
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx
# NEXT_PUBLIC_ADSENSE_SLOT_HOME=xxxxxxxxxx

# Adsterra — bannière NATIVE (discrete). Utilisée si AdSense absent.
# SCRIPT = src complet du tag invoke.js ; CONTAINER = id du div conteneur.
# NEXT_PUBLIC_ADSTERRA_SCRIPT=//plxxxxxx.highperformanceformat.com/xxxxxx/invoke.js
# NEXT_PUBLIC_ADSTERRA_CONTAINER=container-xxxxxx
